rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Live location tracking rules
    match /live_users/{uid} {
      // Allows deleting users from the console
      allow read, write: if request.auth != null;
    }

    // App config (password & settings)
    match /app_config/{doc} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // User preferences & played history
    match /users/{uid} {
      // Allow the admin app to read and delete user data
      allow read, write: if request.auth != null;

      // FIX: Allow writing & reading device metadata sub-collection
      match /devices/{deviceId} {
        allow read, write: if request.auth != null;
      }
    }

    // Pending chat deliveries
    match /pending_deliveries/{document=**} {
      // Allow admin app to delete pending message queues
      allow read, write: if request.auth != null;
    }

    // Global recommendation engines
    match /global_search_history/{doc} {
      allow read, write: if request.auth != null;
    }
    match /global_play_history/{doc} {
      allow read, write: if request.auth != null;
    }
    match /global_transitions/{doc} {
      allow read, write: if request.auth != null;
    }

    // Global ML Engine
    match /ml_engine_synonyms/{doc} {
      // FIX: Enable authenticated reads so the Admin Screen can compute diffs before syncing
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Direct Chats rules (REQUIRED for direct messaging)
    match /direct_chats/{roomId} {
      allow read, write: if request.auth != null;
      
      match /messages/{messageId} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
