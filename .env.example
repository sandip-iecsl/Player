# ==============================================================================
# Aura Player - Production Environment Configuration Template
# ==============================================================================
# Copy this file to .env and provide your private credentials.
# NEVER commit real secret keys, tokens, or credentials into version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend Microservice & Proxy Configuration
# ------------------------------------------------------------------------------
PORT=3000
YOUTUBE_EXTRACTOR_URL=http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# 2. YouTube Data API v3 (Server-Side / Microservice Only)
# ------------------------------------------------------------------------------
# Obtain from: https://console.cloud.google.com/apis/credentials
# Standard YouTube Data API quota: 10,000 units/day allocation; search.list costs 100 units,
# videos.list costs 1 unit. Quota resets at midnight Pacific Time. Verify current Google docs.
YOUTUBE_API_KEY=your_youtube_api_key_here
YOUTUBE_COOKIES_BASE64=base64_encoded_netscape_cookie_secret
YOUTUBE_COOKIES_FILE=/run/secrets/youtube-cookies.txt
YTDLP_JS_RUNTIME=/usr/local/bin/deno

# ------------------------------------------------------------------------------
# 3. Audius Decentralized API
# ------------------------------------------------------------------------------
# Audius offers free tier API access for open streaming and discovery
# App name registration: https://audius.org / https://api.audius.co
AUDIUS_API_KEY=your_audius_api_key_optional
AUDIUS_BEARER_TOKEN=your_audius_bearer_token_optional

# ------------------------------------------------------------------------------
# 4. Jamendo Music API (Creative Commons Open Catalog)
# ------------------------------------------------------------------------------
# Obtain free client ID from: https://developer.jamendo.com/v3.0
JAMENDO_CLIENT_ID=ef24db83

# ------------------------------------------------------------------------------
# 5. Spotify Web API (Metadata & Recommendations)
# ------------------------------------------------------------------------------
# Obtain from: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=867d04fee02d4d849b406149c1f4295c
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIFY_REDIRECT_URI=http://localhost:8888/callback

# ------------------------------------------------------------------------------
# 6. Deezer Music API
# ------------------------------------------------------------------------------
# Feature flag to enable Deezer 30s previews and metadata search
DEEZER_ENABLED=true

# ------------------------------------------------------------------------------
# 7. MongoDB Atlas Search Configuration (M0 Free Cluster)
# ------------------------------------------------------------------------------
# Obtain from: https://cloud.mongodb.com/
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/aura_player?retryWrites=true&w=majority
MONGODB_DATA_API_URL=https://data.mongodb-api.com/app/data-xxxx/endpoint/data/v1/action/aggregate
MONGODB_API_KEY=your_mongodb_atlas_data_api_key_here
MONGODB_DATABASE=aura_player
MONGODB_COLLECTION=songs
MONGODB_SEARCH_INDEX=search_index

# ------------------------------------------------------------------------------
# 8. Last.fm API (Trending & Recommendations)
# ------------------------------------------------------------------------------
# Obtain from: https://www.last.fm/api/account/create
LASTFM_API_KEY=your_lastfm_api_key_here

# ------------------------------------------------------------------------------
# 9. Firebase Configuration (Dual Database Architecture)
# ------------------------------------------------------------------------------
# Main DB: (default)
# Chat DB: databaseId: 'chat' (STRICTLY ISOLATED)
FIREBASE_PROJECT_ID=your_firebase_project_id
